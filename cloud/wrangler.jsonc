{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pinny-capture",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "pinny-inbox",
    // Deployed database; Wrangler --local still uses isolated local state.
    "database_id": "3847c04a-250e-44b1-a5ee-a1acd346b164",
    "migrations_dir": "migrations"
  }]
}
